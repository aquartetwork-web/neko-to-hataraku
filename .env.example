# Hosted Supabase project settings (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set this per Vercel environment. Leave empty locally to use the request origin.
NEXT_PUBLIC_SITE_URL=

# Optional display-name override. The default is defined in src/config/app.ts.
NEXT_PUBLIC_APP_NAME=
